<!DOCTYPE html>
<html lang="tl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>For Crish 💜</title>
<style>
:root{--bg:#07020f;--glow:#b44dff;--text:#f1dcff}
html,body{height:100%;margin:0}
body{background:radial-gradient(circle at 50% 40%,#2a0a4a,var(--bg) 70%);color:var(--text);font-family:Georgia,'Times New Roman',serif;overflow:hidden;display:flex;align-items:center;justify-content:center;text-align:center;padding:env(safe-area-inset-top,0) 0 env(safe-area-inset-bottom,0)}
#intro{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px;cursor:pointer;transition:opacity .8s;z-index:5;-webkit-tap-highlight-color:transparent}
#intro.gone{opacity:0;pointer-events:none;visibility:hidden}
h2{margin:0;font-weight:400;letter-spacing:3px;text-shadow:0 0 14px var(--glow)}
.heartwrap{position:relative;width:190px;height:170px;animation:beat 1.3s infinite}
.half{position:absolute;top:0;width:50%;height:100%;overflow:hidden;transition:transform 1s ease,opacity 1s ease .3s}
.half.l{left:0;transform-origin:0 100%}.half.r{right:0;transform-origin:100% 100%}
.half svg{position:absolute;top:0;width:190px;height:170px;filter:drop-shadow(0 0 18px var(--glow)) drop-shadow(0 0 40px #8a2be2)}
.half.l svg{left:0}.half.r svg{right:0}
#intro.open .heartwrap{animation:none}
#intro.open .l{transform:translateX(-60px) rotate(-35deg);opacity:0}
#intro.open .r{transform:translateX(60px) rotate(35deg);opacity:0}
@keyframes beat{0%,100%{transform:scale(1)}15%{transform:scale(1.12)}30%{transform:scale(1)}45%{transform:scale(1.08)}}
.btn{font-size:1rem;padding:12px 26px;border-radius:30px;border:1px solid var(--glow);background:rgba(180,77,255,.12);color:var(--text);box-shadow:0 0 18px rgba(180,77,255,.6);animation:pulse 2s infinite;font-family:inherit}
@keyframes pulse{50%{box-shadow:0 0 34px rgba(180,77,255,1)}}
#scene{opacity:0;transition:opacity 1.2s;position:relative;z-index:1;display:flex;flex-direction:column;align-items:center;gap:20px;perspective:900px;padding:16px}
#scene.show{opacity:1}
h1{margin:0;font-weight:400;font-size:clamp(1.5rem,6vw,2.4rem);text-shadow:0 0 10px var(--glow),0 0 30px var(--glow);animation:flick 3s infinite alternate}
@keyframes flick{to{text-shadow:0 0 16px #d9a0ff,0 0 48px #a020f0}}
.rose{width:min(72vw,52vh,420px);aspect-ratio:1;border-radius:18px;object-fit:cover;box-shadow:0 0 30px 6px rgba(180,77,255,.7),0 0 90px 20px rgba(138,43,226,.5);animation:spin 7s linear infinite;transform-style:preserve-3d}
@keyframes spin{to{transform:rotateY(360deg)}}
.p{position:fixed;top:-20px;font-size:18px;opacity:.7;animation:fall linear infinite;pointer-events:none;filter:drop-shadow(0 0 6px var(--glow))}
@keyframes fall{to{transform:translateY(110vh) rotate(360deg)}}
#rose{width:min(86vw,440px);height:min(58vh,520px)}#rose canvas{width:100%!important;height:100%!important;filter:drop-shadow(0 0 25px rgba(180,77,255,.6))}</style></head><body>
<div id="intro"><h2>my heart</h2>
<div class="heartwrap">
<div class="half l"><svg viewBox="0 0 100 90"><path d="M50 85C10 55 0 35 0 22 0 8 11 0 24 0c11 0 21 6 26 16C55 6 65 0 76 0c13 0 24 8 24 22 0 13-10 33-50 63z" fill="#9b30ff"/></svg></div>
<div class="half r"><svg viewBox="0 0 100 90"><path d="M50 85C10 55 0 35 0 22 0 8 11 0 24 0c11 0 21 6 26 16C55 6 65 0 76 0c13 0 24 8 24 22 0 13-10 33-50 63z" fill="#9b30ff"/></svg></div>
</div>
<button class="btn">please open my heart 💜</button></div>
<div id="scene"><h1>Hi Crish 💜</h1><div id="rose"></div><img style="display:none" class="rose" alt="purple rose" src="data:image/jpeg;base64,"><h2>flower for you</h2></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
const intro=document.getElementById('intro'),scene=document.getElementById('scene');
let opened=false;function openHeart(){if(opened)return;opened=true;intro.classList.add('open');setTimeout(()=>{intro.classList.add('gone');scene.classList.add('show');petals()},800)}
intro.addEventListener('click',openHeart);intro.addEventListener('touchend',openHeart);document.querySelector('.btn').addEventListener('click',openHeart);
function initRose(){
const box=document.getElementById('rose'),W=box.clientWidth||400,H=box.clientHeight||450;
const R=new THREE.WebGLRenderer({antialias:true,alpha:true});R.setPixelRatio(Math.min(devicePixelRatio,2));R.setSize(W,H,false);box.appendChild(R.domElement);
const S=new THREE.Scene(),cam=new THREE.PerspectiveCamera(40,W/H,.1,50);cam.position.set(0,-.1,6.6);cam.lookAt(0,-.1,0);
function pt(w,h,cup,curl,x,y){const e=Math.pow(Math.sin(Math.PI*(.1+.85*y)),.6),ax=Math.abs(2*x);return [x*w*e*2,y*h,-cup*ax*ax*.35*(.4+y)*w+curl*y*y*h*.3*(1+ax)];}
function pgeo(w,h,cup,curl,c){const g=new THREE.PlaneGeometry(1,1,14,14),p=g.attributes.position,col=[];for(let i=0;i<p.count;i++){const x=p.getX(i),y=p.getY(i)+.5,q=pt(w,h,cup,curl,x,y);p.setXYZ(i,q[0],q[1],q[2]);const ax=Math.abs(2*x),s=.3+.7*Math.pow(y,.8),ed=.25*ax*ax*ax*y;col.push(c[0]*s+ed*.6,c[1]*s+ed*.3,c[2]*s+ed*.9);}g.setAttribute('color',new THREE.Float32BufferAttribute(col,3));g.computeVertexNormals();return g;}
const pm=new THREE.MeshPhysicalMaterial({vertexColors:true,side:THREE.DoubleSide,roughness:.4,clearcoat:.5,clearcoatRoughness:.3,emissive:0x20003c});
const lm=new THREE.MeshPhysicalMaterial({vertexColors:true,side:THREE.DoubleSide,roughness:.35,clearcoat:.8,emissive:0x0a0018});
const dm=new THREE.MeshPhysicalMaterial({color:0xe0c0ff,roughness:0,transparent:true,opacity:.6,clearcoat:1,emissive:0x5a2a90});
const dg=new THREE.SphereGeometry(1,12,10),plant=new THREE.Group(),head=new THREE.Group(),tiltG=new THREE.Group();
head.position.y=.6;head.scale.setScalar(.85);plant.add(head);
function place(m,a,tilt,px,py,pz){m.rotation.order='YXZ';m.rotation.set(tilt,a,0);m.position.set(px,py,pz);}
const N=36;
for(let i=0;i<N;i++){const t=i/(N-1),a=i*2.39996,w=.26+.5*Math.pow(t,.9),h=.55+.5*t,cup=1.6-t,curl=.2+1.6*t*t,tilt=.06+1.15*Math.pow(t,1.3),r=.02+.5*Math.pow(t,.85);
const m=new THREE.Mesh(pgeo(w,h,cup,curl,[.5,.1,.9]),pm);place(m,a,tilt,Math.sin(a)*r,-.05*t+.02,Math.cos(a)*r);head.add(m);
if(t>.45)for(let k=0;k<4;k++){const q=pt(w,h,cup,curl,(Math.random()-.5)*.8,.2+Math.random()*.7),d=new THREE.Mesh(dg,dm),s=.012+Math.random()*.028;d.position.set(q[0],q[1],q[2]-.02);d.scale.set(s,s,s*.7);m.add(d);}}
for(let i=0;i<5;i++){const a=i*1.2566,m=new THREE.Mesh(pgeo(.1,.75,.3,.3,[.15,.4,.12]),lm);place(m,a,2.3,Math.sin(a)*.1,-.12,Math.cos(a)*.1);head.add(m);}
const stem=new THREE.Mesh(new THREE.CylinderGeometry(.045,.06,3,10),new THREE.MeshStandardMaterial({color:0x1d3b1a,roughness:.5}));stem.position.y=-.9;plant.add(stem);
[[-.9,.8,1.3],[-1.5,3.9,1.1]].forEach(l=>{const m=new THREE.Mesh(pgeo(.38,1.2,.5,.6,[.12,.35,.12]),lm);place(m,l[1],l[2],0,l[0],0);plant.add(m);});
tiltG.rotation.x=.28;tiltG.add(plant);S.add(tiltG);
S.add(new THREE.AmbientLight(0x7a3ac0,.9));
const dl=new THREE.DirectionalLight(0xe6c0ff,1.3);dl.position.set(2,4,4);S.add(dl);
const p1=new THREE.PointLight(0xb44dff,2.2,12);p1.position.set(-2.5,1,3);S.add(p1);
const p2=new THREE.PointLight(0x8833ff,3,12);p2.position.set(0,2,-3);S.add(p2);
const c=document.createElement('canvas');c.width=c.height=128;const cx=c.getContext('2d'),gr=cx.createRadialGradient(64,64,0,64,64,64);gr.addColorStop(0,'rgba(190,90,255,.9)');gr.addColorStop(1,'rgba(120,30,200,0)');cx.fillStyle=gr;cx.fillRect(0,0,128,128);
const sp=new THREE.Sprite(new THREE.SpriteMaterial({map:new THREE.CanvasTexture(c),blending:THREE.AdditiveBlending,transparent:true,depthWrite:false}));sp.scale.set(5,5,1);sp.position.set(0,.8,-1.5);S.add(sp);
(function loop(t){requestAnimationFrame(loop);t*=.001;plant.rotation.y=t*.6;tiltG.position.y=.2+Math.sin(t*1.2)*.05;sp.material.opacity=.7+.25*Math.sin(t*2);p1.intensity=2+Math.sin(t*3);R.render(S,cam);})(0);
}
try{initRose()}catch(e){document.querySelector('img.rose').style.display='block'}
function petals(){for(let i=0;i<14;i++){const s=document.createElement('span');s.className='p';s.textContent='💜';s.style.left=Math.random()*100+'vw';s.style.animationDuration=(6+Math.random()*8)+'s';s.style.animationDelay=(-Math.random()*10)+'s';s.style.fontSize=(12+Math.random()*16)+'px';document.body.appendChild(s)}}
</script></body></html>